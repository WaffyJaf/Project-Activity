generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model event_posts {
  post_id               Int                      @id @default(autoincrement())
  project_id            Int?
  ms_id                 String?                  @db.VarChar(255)
  post_content          String?                  @db.Text
  imge_url              String?                  @db.VarChar(255)
  post_date             DateTime?                @default(now()) @db.Timestamp(0)
  post_status           event_posts_post_status? @default(active)
  location_post         String?                  @db.VarChar(255)
  hour_post             Int?
  post_datetime         DateTime?                @db.DateTime(0)
  registration_start    DateTime?                @db.DateTime(0)
  registration_end      DateTime?                @db.DateTime(0)
  project_activity      project_activity?        @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction, map: "event_posts_ibfk_1")
  user                  users_up?                @relation("UserEventPosts", fields: [ms_id], references: [ms_id])
  registration_activity registration_activity[]

  notifications notifications[] @relation("EventPostNotifications")

  @@index([project_id], map: "project_id")
  @@index([ms_id])
}

model project_activity {
  project_id          Int                                  @id @default(autoincrement())
  ms_id               String?                              @db.VarChar(255)
  project_name        String                               @db.VarChar(255)
  project_description String?                              @db.Text
  department          String?                              @db.VarChar(255)
  location            String?                              @db.VarChar(255)
  budget              Decimal?                             @db.Decimal(15, 2)
  hours               Int
  created_date        DateTime?                            @default(now()) @db.Timestamp(0)
  project_status      project_activity_project_status      @default(pending)
  project_datetime    DateTime?                            @db.DateTime(0)
  approval_datetime   DateTime?                            @db.DateTime(0)
  qrCodeData          String?                              @db.VarChar(255)
  project_year        String?                              @db.VarChar(255)
  phone               String?                              @db.VarChar(20)
  project_enddate     DateTime?                            @db.DateTime(0)
  evaluation_form_url String?                              @db.VarChar(500)
  has_evaluation      Boolean?                             @default(false)
  evaluation_statuspj project_activity_evaluation_statuspj @default(awaiting_evaluation)


  rejected_reason     String?                              @db.Text

  activity_record       activity_record[]
  event_posts           event_posts[]
  user                  users_up?               @relation("UserProjectActivity", fields: [ms_id], references: [ms_id])
  registration_activity registration_activity[]
  activity_hours_log    activity_hours_log[]

  @@index([ms_id])
}


model registration_activity {
  register_id  Int    @id @default(autoincrement())
  post_id      Int?
  ms_id        String @db.VarChar(255) // ขนาดควรเหมือนกันกับ users_up.ms_id
  student_name String @db.VarChar(255)
  faculty      String @db.VarChar(255)
  project_id   Int?

  event_posts      event_posts?      @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction, map: "registration_activity_ibfk_1")
  project_activity project_activity? @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction, map: "registration_activity_ibfk_2")

  sers_up users_up @relation("UserRegistrationActivities", fields: [ms_id], references: [ms_id], onDelete: NoAction, onUpdate: NoAction, map: "registration_activity_ibfk_3")

  @@index([post_id], map: "post_id")
  @@index([project_id], map: "project_id")
  @@index([ms_id], map: "ms_id")
}

model users_up {
  id                      Int?
  ms_id                   String                  @id @db.VarChar(255)
  role                    String?                 @default("user") @db.VarChar(50)
  created_at              DateTime?               @default(now()) @db.Timestamp(0)
  givenName               String?                 @db.VarChar(255)
  surname                 String?                 @db.VarChar(255)
  jobTitle                String?                 @db.VarChar(255)
  department              String?                 @db.VarChar(255)
  displayName             String?                 @db.VarChar(255)
  qrCodeId                String?                 @unique(map: "qrCodeId") @db.VarChar(255)
  totalActivityHours      Int                     @default(0)
  activity_record         activity_record[]
  event_posts             event_posts[]           @relation("UserEventPosts")
  project_activity        project_activity[]      @relation("UserProjectActivity")
  registration_activities registration_activity[] @relation("UserRegistrationActivities")
  device_tokens           device_tokens[]
  notifications           notifications[]
  activity_hours_log      activity_hours_log[]
  roleChangeRequests RoleChangeRequest[] @relation("UserRequests")
  reviewedRequests   RoleChangeRequest[] @relation("ReviewedByUser")
}

model RoleChangeRequest {
  id             Int           @id @default(autoincrement())
  userId         String
  user           users_up      @relation("UserRequests", fields: [userId], references: [ms_id])

  currentRole    UserRole
  requestedRole  UserRole

  reason         String?
  status         RequestStatus @default(pending)

  reviewedBy     String?
  reviewedByUser users_up?     @relation("ReviewedByUser", fields: [reviewedBy], references: [ms_id])
  reviewedAt     DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
}

model activity_record {
  id                Int                               @id @default(autoincrement())
  project_id        Int
  ms_id             String                            @db.VarChar(100)
  joined_at         DateTime?                         @default(now()) @db.DateTime(0)
  evaluation_status activity_record_evaluation_status @default(PENDING)
  project_activity  project_activity                  @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "activity_record_ibfk_1")
  users_up          users_up                          @relation(fields: [ms_id], references: [ms_id], onDelete: Cascade, onUpdate: NoAction, map: "activity_record_ibfk_2")

  @@index([ms_id], map: "ms_id")
  @@index([project_id], map: "project_id")
}

model device_tokens {
  id        Int      @id @default(autoincrement())
  ms_id     String   @db.VarChar(255)
  token     String   @unique
  createdAt DateTime @default(now())

  user users_up @relation(fields: [ms_id], references: [ms_id])

  @@unique([ms_id, token])
  @@index([ms_id])
}

model notifications {
  id         Int      @id @default(autoincrement())
  ms_id      String   @db.VarChar(255)
  title      String   @db.VarChar(255)
  body       String?  @db.Text
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  event_post_id Int?

  data Json?

  user       users_up     @relation(fields: [ms_id], references: [ms_id])
  event_post event_posts? @relation("EventPostNotifications", fields: [event_post_id], references: [post_id])

  @@index([ms_id])
  @@index([event_post_id])
}

model activity_hours_log {
  id               Int              @id @default(autoincrement())
  ms_id            String           @db.VarChar(255)
  project_id       Int
  hours_added      Int
  added_at         DateTime         @default(now())
  users_up         users_up         @relation(fields: [ms_id], references: [ms_id])
  project_activity project_activity @relation(fields: [project_id], references: [project_id])

  @@index([ms_id])
  @@index([project_id])
}

enum event_posts_post_status {
  active
  expired
}

enum project_activity_project_status {
  pending
  approved
  rejected
}

enum activity_record_evaluation_status {
  PENDING
  COMPLETED
  NOT_EVALUATED
}

enum project_activity_evaluation_statuspj {
  awaiting_evaluation
  evaluated
}

enum RequestStatus {
  pending
  approved
  rejected
  canceled
}

enum UserRole {
  admin
  organizer
  user
}
